{
  "name": "@tokenhub/server",
  "version": "0.0.5",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "test": "tsx --test test/relay-core.test.ts test/relay-binding.test.ts test/chat-completions.test.ts test/native-sse.test.ts test/api-key-encryption.test.ts test/admin-user-security.test.ts test/credential-bulk.test.ts test/upstream-channel-metadata.test.ts test/upstream-channel-update.test.ts test/upstream-protocol-config.test.ts test/upstream-connection-test.test.ts test/channel-overview.test.ts test/ticket-system.test.ts test/v003.test.ts",
    "test:relay:live": "tsx test/live-relay-smoke.ts",
    "test:relay:mock": "tsx test/mock-relay-integration.ts",
    "test:relay:native:mock": "tsx test/mock-native-protocol-integration.ts",
    "test:v001:api": "tsx test/v001-api-key-integration.ts",
    "test:v001:binding": "tsx test/v001-hard-binding-integration.ts",
    "test:v003:integration": "tsx test/v003-integration.ts",
    "test:v005:integration": "tsx test/v005-integration.ts",
    "start": "node dist/index.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:cleanup-demo": "tsx src/db/cleanup-demo-data.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.39.3",
    "fastify": "^5.2.1",
    "ioredis": "^5.5.0",
    "jose": "^5.9.6",
    "postgres": "^3.4.5",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.13.4",
    "drizzle-kit": "^0.30.4",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
