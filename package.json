{
  "name": "tokenhub",
  "private": true,
  "version": "0.1.0",
  "description": "Internal LLM gateway: shared official keys, full audit, no billing",
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "npm run dev --workspace=@tokenhub/server",
    "dev:web": "npm run dev --workspace=@tokenhub/web",
    "build": "npm run build --workspace=@tokenhub/server && npm run build --workspace=@tokenhub/web",
    "test:server": "npm test --workspace=@tokenhub/server",
    "db:generate": "npm run db:generate --workspace=@tokenhub/server",
    "db:migrate": "npm run db:migrate --workspace=@tokenhub/server",
    "db:seed": "npm run db:seed --workspace=@tokenhub/server",
    "db:cleanup-demo": "npm run db:cleanup-demo --workspace=@tokenhub/server",
    "db:setup": "npm run db:migrate && npm run db:seed"
  },
  "engines": {
    "node": "^20.17.0 || >=22.9.0"
  },
  "packageManager": "npm@11.16.0"
}
