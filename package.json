{
  "name": "kodax-fabric",
  "private": true,
  "version": "0.1.0",
  "description": "KodaX Fabric — enterprise token access platform; Token Hub module provides shared official LLM keys, relay, and audit",
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "npm run dev --workspace=@kodax-fabric/server",
    "dev:web": "npm run dev --workspace=@kodax-fabric/web",
    "build": "npm run build --workspace=@kodax-fabric/server && npm run build --workspace=@kodax-fabric/web",
    "test:server": "npm test --workspace=@kodax-fabric/server",
    "db:generate": "npm run db:generate --workspace=@kodax-fabric/server",
    "db:migrate": "npm run db:migrate --workspace=@kodax-fabric/server",
    "db:seed": "npm run db:seed --workspace=@kodax-fabric/server",
    "db:cleanup-demo": "npm run db:cleanup-demo --workspace=@kodax-fabric/server",
    "db:setup": "npm run db:migrate && npm run db:seed"
  },
  "engines": {
    "node": "^20.17.0 || >=22.9.0"
  },
  "packageManager": "npm@11.16.0",
  "dependencies": {
    "pptxgenjs": "^4.0.1"
  }
}
