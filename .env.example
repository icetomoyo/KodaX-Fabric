# Copy to .env and fill from colima-databases/.env (do not commit real secrets)

# PostgreSQL (use dedicated database tokenhub)
DATABASE_URL=postgresql://app:YOUR_POSTGRES_PASSWORD@127.0.0.1:5432/tokenhub

# Redis (db index 1 to avoid collisions with other apps)
REDIS_URL=redis://:YOUR_REDIS_PASSWORD@127.0.0.1:6379/1

# API
PORT=3100
HOST=0.0.0.0
CORS_ORIGIN=http://127.0.0.1:5173

# Relay
RELAY_UPSTREAM_TIMEOUT_MS=300000
RELAY_MAX_ATTEMPTS=3
RELAY_COOLDOWN_SECONDS=60
RELAY_SAFEGUARD_RPM=60
RELAY_SAFEGUARD_MAX_CONCURRENCY=5
QUOTA_TIMEZONE=Asia/Shanghai
RELAY_RESPONSE_MAX_BYTES=104857600
AUDIT_BODY_MAX_BYTES=20971520

# Auth — generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string

# Encrypt upstream provider secrets (AES) — 32+ chars
CREDENTIAL_ENCRYPT_KEY=change-me-to-another-long-random-string

# Initial admin (seed only, used when no admin exists)
SEED_ADMIN_NAME=管理员
SEED_ADMIN_PHONE=13800000000
SEED_ADMIN_PASSWORD=ChangeMe@123
