# 复制为 .env 并填入真实值（勿提交真实密钥），所有变量在 server/src/config.ts 中校验

# PostgreSQL（本机 5432 → base-postgres）
DATABASE_URL=postgresql://tokenhub:xx@127.0.0.1:5432/tokenhub

# Redis（本机 6379 → base-redis，db 0 与 API 容器一致）
REDIS_URL=redis://:xx@127.0.0.1:6379/0

# JWT 签名密钥，生成：openssl rand -base64 48
JWT_SECRET=xx

# 上游渠道密钥的加密密钥，生成：openssl rand -base64 32
CREDENTIAL_ENCRYPT_KEY=xx

# API 服务（Node 惯例 3000；Vite 前端 5173。生产容器内同样监听 3000，对外走 443）
PORT=3000
HOST=0.0.0.0
CORS_ORIGIN=http://127.0.0.1:5173

# 前端开发代理目标（/api /health /ai），默认指向本地 API，需要连线上时取消注释
# DEV_API_TARGET=https://tokenhub.haizhi.com

# Token Bot：只需填写 SUPPORT_BOT_UPSTREAM_API_KEY
SUPPORT_BOT_UPSTREAM_BASE_URL=https://open.bigmodel.cn/api/coding/paas/v4
SUPPORT_BOT_MODEL=glm-5.3-flash
SUPPORT_BOT_UPSTREAM_API_KEY=xx

# 钉钉企业内部应用（开发者后台 → 应用详情 → AppKey / AppSecret）
# 权限：通讯录部门信息读权限。填写后重启 API。
DINGTALK_APP_KEY=xx
DINGTALK_APP_SECRET=xx

# 公司 LDAP（与 Wiki 同一套账号）。登录名是 uid，不是手机号。
LDAP_URL=ldap://ldap.haizhi.com:389
LDAP_BASE=ou=People,dc=haizhi,dc=com
