# 复制为 .env 并填入真实值（勿提交真实密钥），所有变量在 server/src/config.ts 中校验

# PostgreSQL 连接串（密码从 colima-databases/.env 获取）
DATABASE_URL=postgresql://app:YOUR_POSTGRES_PASSWORD@127.0.0.1:5432/tokenhub

# Redis 连接串（密码从 colima-databases/.env 获取，用 db 1 避免和其他应用冲突）
REDIS_URL=redis://:YOUR_REDIS_PASSWORD@127.0.0.1:6379/1

# JWT 签名密钥，生成：openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string

# 上游渠道密钥的加密密钥，生成：openssl rand -base64 32
CREDENTIAL_ENCRYPT_KEY=change-me-to-another-long-random-string

# API 服务（Node 惯例 3000；Vite 前端 5173。生产容器内同样监听 3000，对外走 443）
PORT=3000
HOST=0.0.0.0
CORS_ORIGIN=http://127.0.0.1:5173

# 前端开发代理目标（/api /health /ai），默认指向本地 API，需要连线上时取消注释
# DEV_API_TARGET=https://tokenhub.haizhi.com

# Seconds a credential stays cooled after upstream quota/balance exhaustion (HTTP 429, e.g. GLM 1113).
# RELAY_QUOTA_COOLDOWN_SECONDS=1800

# 读取上游响应正文的上限（用于解析 usage），不落库。
# AUDIT_BODY_MAX_BYTES=1048576

# Capacity cooling-ratio alert (per active product line). Interval min 10s.
# ALERT_CHECK_INTERVAL_SECONDS=60
# ALERT_COOLING_RATIO_THRESHOLD=0.3
# ALERT_SILENCE_SECONDS=900
# WeCom/DingTalk robot webhook. Leave unset to keep warn logs only.
# ALERT_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=YOUR_KEY
